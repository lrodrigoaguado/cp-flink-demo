# versions.env — single source of truth for the pinned versions used by BOTH
# the manual README steps and run_all.sh. Bump a version here and both deploy
# paths stay in sync.
#
# Manual path: run `source versions.env` once in your shell, then the README
# commands that reference these variables (e.g. "$CFK_OPERATOR_VERSION") work
# copy-paste. The scripted path (run_all.sh) sources this file automatically.

# Kubernetes node image for the local kind cluster.
# NOTE: requires kind CLI >= v0.32.0 (older CLIs fail with
# "unknown containerd config version: 4").
export KIND_NODE_IMAGE="kindest/node:v1.35.5"

# Confluent for Kubernetes (CFK) operator Helm chart.
export CFK_OPERATOR_VERSION="0.1718.10"

# Elastic Cloud on Kubernetes (ECK) operator Helm chart.
export ECK_OPERATOR_VERSION="3.4.0"

# cert-manager release (required by the Flink Kubernetes Operator).
export CERT_MANAGER_VERSION="v1.20.2"

# CP Flink Kubernetes Operator Helm chart.
export FLINK_OPERATOR_VERSION="1.140.1"

# Confluent Manager for Apache Flink (CMF) Helm chart.
export CMF_VERSION="2.3.1"
